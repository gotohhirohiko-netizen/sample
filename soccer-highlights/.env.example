# YouTubeへの自動アップロード機能を使う場合のみ設定する。
# Google Cloud Consoleで「OAuthクライアントID」(種類: デスクトップアプリ or ウェブアプリケーション)を作成し、
# 承認済みのリダイレクトURIに http://localhost:8787/api/youtube/oauth2callback を追加すること。
# 詳細はREADME.mdの「YouTubeアップロード設定」を参照。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/youtube/oauth2callback

# サーバーのポート(省略時は8787)
PORT=8787

# 空き容量がこれを下回ったら書き出し処理を開始/継続しない(単位: GB、省略時は3)
MIN_FREE_DISK_GB=3

# yt-dlpが最新版でも "HTTP Error 403: Forbidden" が出る場合のみ設定する(どちらか一方でよい)。
#
# 方法1(推奨): ブラウザ拡張機能でエクスポートしたcookies.txtファイルのパスを指定する。
# 「Could not copy Chrome cookie database」エラーが出る場合はこちらを使うこと。
YTDLP_COOKIES_FILE=
#
# 方法2: 指定したブラウザにログイン済みのCookieを直接使う(例: chrome / edge / firefox)。
# プロファイルを指定する場合は "chrome:Default" のように書く。
# ブラウザ(バックグラウンドプロセス含む)を完全に終了しておかないと
# 「Could not copy Chrome cookie database」エラーになることがある。
YTDLP_COOKIES_FROM_BROWSER=

# Cookieを設定しても "HTTP Error 403: Forbidden" が解消しない場合のみ設定する。
# YouTube側のボット対策強化でyt-dlpが使う取得方法(player_client)自体がブロックされて
# いることがあり、その場合は取得方法を変えると直ることがある。試す値の例(READMEも参照):
# YTDLP_EXTRA_ARGS=--extractor-args youtube:player_client=android
YTDLP_EXTRA_ARGS=

# "Got error: N bytes read, M more expected. Giving up after 10 retries" のような
# ダウンロード中の接続切れが頻発する場合のみ true にする(Windowsでよくある、IPv6経路の不安定さが原因)。
YTDLP_FORCE_IPV4=
